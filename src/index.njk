---
layout: base.njk
---
{% import "cards.njk" as c %}
<section class="hero">
  <div class="hero-text">
    <p class="eyebrow">{{ site.person.name }}的個人講古攤</p>
    <h1>勇博<span>講古</span></h1>
    <p class="tagline">{{ site.tagline }}</p>
    <p class="hero-links">
      <a class="btn" href="/articles/">開始讀文章</a>
      <a class="btn ghost" href="/about/">認識我</a>
    </p>
  </div>
  <div class="hero-seal" aria-hidden="true"><span class="seal seal-lg">勇博講古</span></div>
</section>

<div class="home-main">
  <section class="home-articles">
    <div class="section-head"><h2>最近講的</h2><a href="/articles/">所有文章 →</a></div>
    <ol class="entries">{% for a in collections.recent | first(7) %}{{ c.feedRow(a) }}{% endfor %}</ol>
  </section>

  <aside class="home-side">
    <section class="side-block about-card">
      <h2>講古的人</h2>
      <p>{{ site.bio }}</p>
      <a href="/about/">更多關於我 →</a>
    </section>
    {% if collections.finance.length %}
    <section class="side-block">
      <div class="section-head"><h2>勇博開講</h2><a href="/finance/">全部 →</a></div>
      <ul class="lessons">{% for e in collections.finance | first(3) %}<li class="lesson"><a href="{{ e.url }}"><span class="lesson-meta">{{ e.date | ymd }}</span><span class="lesson-title">{{ e.data.title }}</span></a></li>{% endfor %}</ul>
    </section>
    {% endif %}
    {% if collections.teaching.length %}
    <section class="side-block">
      <div class="section-head"><h2>教學分享</h2><a href="/teaching/">全部 →</a></div>
      <ul class="lessons">{% for l in collections.teaching | first(3) %}{{ c.lessonRow(l) }}{% endfor %}</ul>
    </section>
    {% endif %}
  </aside>
</div>

{% if collections.stories.length %}
<section class="night-band">
  <div class="section-head"><h2>晚安故事</h2><a href="/stories/">全部 {{ collections.stories.length }} 本 →</a></div>
  <div class="shelf shelf-row">
    {%- for s in collections.stories | first(5) %}
    <a class="book" href="{{ s.url }}"><img src="{{ s.data.cover }}" alt="" loading="lazy" width="540" height="960"><span class="book-title">{{ s.data.title }}</span><span class="book-meta">{{ s.data.pages.length }} 頁・有聲</span></a>
    {%- endfor %}
  </div>
</section>
{% endif %}

<section class="lab">
  <div class="section-head"><h2>AI 遊樂場</h2><a href="/games/">全部 {{ collections.games.length }} 款遊戲 →</a></div>
  <div class="grid games">{% for g in collections.games | first(6) %}{{ c.card(g, g.data.gameTags) }}{% endfor %}</div>
</section>
